generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ================= ENUMS =================
enum Role {
  ADMIN
  BAN_GIAM_DOC
  LEADER
  CONTENT
  EDITOR
  CHANNEL_MANAGER
  HR
  KE_TOAN
  PUBLISHER
}

// 🚀 ĐÃ SỬA: Chẻ nhỏ trạng thái Task theo từng trạm
enum TaskStatus {
  TODO
  CONTENT_DOING
  CONTENT_REVIEW
  ANIMATION_DOING
  ANIMATION_REVIEW
  EDIT_DOING
  EDIT_REVIEW
  DONE 
  BACKLOG
}

enum RequestType {
  // HR
  NGHI_PHEP
  DI_MUON_VE_SOM
  LAM_REMOTE
  // Admin & Kế toán
  MUA_SAM
  TAM_UNG
  CHAY_ADS
  THANH_TOAN
  THUONG
}

enum RequestStatus {
  PENDING_1 // Đang chờ cấp 1 duyệt (VD: Leader)
  PENDING_2 // Cấp 1 đã duyệt, chờ cấp 2 (VD: Giám đốc)
  APPROVED // Đã duyệt hoàn toàn
  REJECTED // Bị từ chối ở bất kỳ cấp nào
  CANCELLED
}

enum ApprovalAction {
  APPROVED_LEVEL_1
  APPROVED_LEVEL_2
  REJECTED
}

enum RoomType {
  DIRECT
  TEAM
  TASK
  COMPANY
}

// 🚀 ĐÃ SỬA: Thêm các action duyệt/từ chối từng khâu
enum TaskLogAction {
  CREATE_TASK
  UPDATE_STATUS
  UPDATE_LINK
  SUBMIT_SCRIPT
  SUBMIT_VIDEO
  PUBLISH_VIDEO
  COMPLETE_TASK
  REJECT_TASK
  ASSIGN_USER
  DAILY_REPORT
  MERGE_VIDEO
  APPROVE_CONTENT
  REJECT_CONTENT
  APPROVE_ANIMATION
  REJECT_ANIMATION
  APPROVE_EDIT
  REJECT_EDIT
}

// 🚀 ĐÃ THÊM: Phân loại Kênh (AI hoặc Tổng hợp)
enum ChannelCategory {
  AI
  TONG_HOP
}

// 🚀 CÁC ENUM TRẠNG THÁI CHO YOUTUBE
enum MonetizationStatus {
  CHUA_DAT          // Đang cày thông số
  DA_DU_DIEU_KIEN   // Đã đạt 1k Sub/4k Giờ hoặc 10M View Shorts
  CHO_DUYET         // Đang đợi YouTube xem xét đơn
  DA_BAT            // Đã có biểu tượng $ xanh
  TAT_KIEM_TIEN     // Bị tắt do vi phạm hoặc nội dung dùng lại
}

enum ChannelStatus {
  XAY_DUNG      // Kênh mới, đang nuôi
  HOAT_DONG     // Đang up video đều
  CANH_BAO      // Dính gậy bản quyền / Nguyên tắc CĐ
  BAY_KENH      // Bị khoá (Suspended)
  DUNG_HOAT_DONG
}


// ================= MODELS =================

model Team {
  id           String      @id @default(uuid())
  name         String      @unique // VD: Team Anime, Team Manga
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  users        User[]
  tasks        Task[]
  rooms        ChatRoom[] // Group chat riêng của team
  channels     Channel[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  requests  Request[]
  projects  Project[]
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  passwordHash String
  fullName     String
  role         Role    @default(CONTENT)
  isActive     Boolean @default(true)
  isTeamLeader Boolean @default(false)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  // ==========================================
  // THÔNG TIN NHÂN SỰ (HR) BỔ SUNG
  // ==========================================
  employeeCode     String?   @unique // Mã nhân viên
  dob              DateTime? @db.Date // Ngày sinh
  ethnicity        String?   // Dân tộc
  
  cccdNumber       String?   @unique // Số CCCD
  cccdDate         DateTime? @db.Date // Ngày cấp CCCD
  cccdPlace        String?   // Nơi cấp CCCD
  
  permanentAddress String?   @db.Text // Địa chỉ thường trú
  currentAddress   String?   @db.Text // Nơi ở hiện nay
  
  phone            String?   // SĐT
  personalEmail    String?   // Email cá nhân
  
  // Thông tin người thân (Liên hệ khẩn cấp)
  relativeName     String?   // Tên người thân
  relativePhone    String?   // SĐT người thân
  relativeRelation String?   // Mối quan hệ (Bố/Mẹ/Vợ/Chồng)
  
  // Thông tin Thanh toán & Hợp đồng
  bankAccount      String?   // Số tài khoản
  bankName         String?   // Ngân hàng
  joinDate         DateTime? @db.Date // Ngày vào làm
  bhxhNumber       String?   // Số sổ BHXH

  // Relations cho Workflow Task
  tasksCreated       Task[]        @relation("TaskCreator")
  tasksContent       Task[]        @relation("TaskContent")
  tasksEdited        Task[]        @relation("TaskEditor")
  tasksPub           Task[]        @relation("TaskPublisher")
  assignedTasks      Task[]        @relation("TaskAssignee")
  tasksAnimated      Task[]        @relation("TaskAnimator")

  // Relations khác
  weeklyKPIs         WeeklyKPI[]
  requestsSent       Request[]     @relation("Requester")
  requestsApprLevel1 Request[]     @relation("ApproverLevel1")
  requestsApprLevel2 Request[]     @relation("ApproverLevel2")
  approvalLogs       ApprovalLog[] @relation("LogApprover")
  messages           Message[]
  roomMembers        RoomMember[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  taskComments  TaskComment[]
  notifications Notification[]
  taskLogs      TaskLog[]
  avatarUrl     String?
  evaluations   Evaluation[]
  supervisedProjects Project[] @relation("ProjectSupervisor")
  revenueUpdates DailyRevenue[]
  managedChannels   Channel[]       @relation("ChannelManager")
  channelMemberships ChannelMember[]
}

model Permission {
  id        String  @id @default(uuid()) 
  role      String 
  moduleId  String 
  isAllowed Boolean @default(false)

  @@unique([role, moduleId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  keywords    String?    @db.Text 
  linkContent String     @unique 
  status      TaskStatus @default(TODO)

  scriptLink        String? @db.Text 
  englishScriptLink String? @db.Text
  storyboardLink    String? @db.Text 
  audioLink         String? @db.Text 
  thumbnailLink     String? @db.Text 
  videoLink         String? @db.Text 
  publishLink       String? @db.Text 

  publishDate       DateTime? @db.Date 
  duration          Int?     
  note              String? @db.Text

  creatorId     String
  creator       User    @relation("TaskCreator", fields: [creatorId], references: [id])
  
  contentId     String?
  contentUser   User?   @relation("TaskContent", fields: [contentId], references: [id])
  
  editorId      String?
  editorUser    User?   @relation("TaskEditor", fields: [editorId], references: [id])

  // Người làm Chuyển động (CĐ)
  animatorId    String?
  animatorUser  User?   @relation("TaskAnimator", fields: [animatorId], references: [id])

  publisherId   String?
  publisherUser User?   @relation("TaskPublisher", fields: [publisherId], references: [id])

  assigneeId    String?
  assignee      User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  teamId        String?
  team          Team?       @relation(fields: [teamId], references: [id])
  channelId     String?
  channel       Channel?    @relation(fields: [channelId], references: [id])
  
  chatRoom      ChatRoom?
  taskComments  TaskComment[]
  taskLogs      TaskLog[]
  evaluations   Evaluation[]

  isClosed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  episodeNumber Int?           
  isCompilation Boolean        @default(false) 
  mergeCount    Int?           @default(0)     
  sourceTasks   Task[]         @relation("VideoMergeRelation")
  compiledInto  Task[]         @relation("VideoMergeRelation")
  usedInMergeCount Int?        @default(0)
}

model Evaluation {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  score Float

  criteria Json

  kaizenNote String? @db.Text

  evaluatorId String
  evaluator   User   @relation(fields: [evaluatorId], references: [id])

  createdAt DateTime @default(now())

}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique 
  description String?

  teams Team[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyKPI {
  id          String @id @default(uuid())
  year        Int
  month       Int
  weekNumber  Int
  targetValue Int 

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, year, month, weekNumber], name: "user_time_unique")
}

model Request {
  id     String        @id @default(uuid())
  type   RequestType
  status RequestStatus @default(PENDING_1)

  startDate  DateTime? 
  endDate    DateTime? 
  targetDate DateTime? 
  amount     Int? 
  itemName   String? 
  reason     String?   @db.Text 

  contentData Json?

  attachmentUrl String? @db.Text

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  firstApproverId String
  firstApprover   User   @relation("ApproverLevel1", fields: [firstApproverId], references: [id])

  secondApproverId String?
  secondApprover   User?   @relation("ApproverLevel2", fields: [secondApproverId], references: [id])

  logs ApprovalLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalLog {
  id      String         @id @default(uuid())
  action  ApprovalAction 
  comment String?        @db.Text 

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation("LogApprover", fields: [approverId], references: [id])

  createdAt DateTime @default(now())
}

model ChatRoom {
  id   String   @id @default(uuid())
  name String?
  type RoomType

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  members  RoomMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomMember {
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime? @default(now())

  @@id([roomId, userId])
}

model Message {
  id      String  @id @default(uuid())
  content String? @db.Text

  roomId      String
  room        ChatRoom     @relation(fields: [roomId], references: [id])
  attachments Attachment[]
  senderId    String
  sender      User         @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TaskComment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  type      String  @default("info") 
  requestId String?
}

model TaskLog {
  id        String        @id @default(uuid())
  action    TaskLogAction 
  details   String 
  createdAt DateTime      @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id       String @id @default(uuid())
  url      String @db.Text 
  fileType String 
  fileName String 
  fileSize Int? 

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Project {
  id           String  @id @default(cuid())
  name         String
  description  String?
  teamId       String?
  team         Team?   @relation(fields: [teamId], references: [id])
  supervisorId String? 
  supervisor   User?   @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  status       String  @default("ACTIVE")

  workflowNodes Json? 
  workflowEdges Json? 
  criteria      Json?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       Task[]
  channelId     String?
  channel       Channel? @relation(fields: [channelId], references: [id])
}

model Channel {
  id              String   @id @default(uuid())
  name            String   @unique
  link            String?  @db.Text 
  startedAt       DateTime? @db.Date
  topic           String?
  
  // 🚀 ĐÃ THÊM: Kênh sẽ lưu cứng trạng thái là AI hay Tổng hợp
  category        ChannelCategory    @default(TONG_HOP)

  status          ChannelStatus      @default(XAY_DUNG)
  monetization    MonetizationStatus @default(CHUA_DAT)

  teamId          String
  team            Team               @relation(fields: [teamId], references: [id])
  
  managerId       String?
  manager         User?              @relation("ChannelManager", fields: [managerId], references: [id])

  members         ChannelMember[]
  projects        Project[]
  revenues        DailyRevenue[]
  avatarUrl       String?   @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tasks           Task[]
}

model DailyRevenue {
  id          String   @id @default(uuid())
  date        DateTime @db.Date 
  amount      Float    
  views       Int      @default(0)
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  
  updaterId   String
  updater     User     @relation(fields: [updaterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, date]) 
}

model ChannelMember {
  channelId       String
  channel         Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  roleOnChannel   String  

  assignedAt      DateTime @default(now())

  @@id([channelId, userId]) 
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique 
  settingValue Json?    
  updatedAt    DateTime @updatedAt
}